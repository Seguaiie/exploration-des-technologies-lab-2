[Unit]
Description=API du convertisseur emilmor.com
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/emilmor/backend
Environment=NODE_ENV=production
Environment=PORT=3001
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
